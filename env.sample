AI_GATEWAY_API_KEY=

# Optional model overrides. Values must be Vercel AI Gateway model ids.
EVEABLE_ROOT_MODEL=openai/gpt-5.4-mini
INTENT_AGENT_MODEL=openai/gpt-5.4-mini
ORCHESTRATOR_AGENT_MODEL=openai/gpt-5.4-mini
DESIGN_RESEARCH_AGENT_MODEL=openai/gpt-5.4-mini
CODE_WRITER_AGENT_MODEL=openai/gpt-5.4
AUTOFIX_AGENT_MODEL=openai/gpt-5.4-mini
SECURITY_REVIEW_AGENT_MODEL=openai/gpt-5.4-mini
CONVERSATION_AGENT_MODEL=openai/gpt-5.4-mini

# Optional image search for generated applications.
UNSPLASH_ACCESS_KEY=
UNSPLASH_API_BASE_URL=https://api.unsplash.com

# Optional Refero MCP design inspiration for the design_research subagent.
# REFERO_API_KEY is preferred; REFERO_MCP_TOKEN is accepted as a fallback.
REFERO_MCP_URL=https://api.refero.design/mcp
REFERO_API_KEY=
REFERO_MCP_TOKEN=

# Optional server-only placeholders for generated apps that need InsForge.
INSFORGE_API_BASE_URL=
INSFORGE_API_KEY=

# Shared by runtime and web. A Neon pooled Postgres URL; never browser-public.
DATABASE_URL=
# Same random secret on web and runtime, at least 32 characters.
EVEABLE_RUNTIME_SECRET=
# Token for a PRIVATE Vercel Blob store, shared by web and runtime.
BLOB_READ_WRITE_TOKEN=

# Web project only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
APP_ORIGIN=http://localhost:3000
EVE_RUNTIME_ORIGIN=http://127.0.0.1:2000
# Hosted: https://preview.example.net with *.preview.example.net on the web app.
PREVIEW_ORIGIN=http://preview.localhost:3000
# Independent random signing secret, at least 32 characters. Web only.
EVEABLE_PREVIEW_SECRET=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# SDK credentials for hosted sandbox access from local development
VERCEL_OIDC_TOKEN=
VERCEL_PROJECT_ID=

# Explicit local curl/TUI access; ignored when NODE_ENV=production.
EVEABLE_ALLOW_LOCAL_TUI=false
# Durable per-user UTC-day admission limits, not dollar-spend guarantees.
# Shared by messages, restores, and manual Save & Preview operations.
EVEABLE_DAILY_BUILD_LIMIT=20
EVEABLE_DAILY_PUBLISH_LIMIT=10
