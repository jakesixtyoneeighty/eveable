{
  "name": "eveable",
  "description": "Eveable is an alternative to Lovable built on Vercel Eve.",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "audit": "pnpm audit --prod --audit-level=critical",
    "build": "eve build",
    "ci": "pnpm run audit && pnpm run typecheck && pnpm run build && pnpm run smoke",
    "dev": "rm -rf .eve .output .workflow-data && eve dev --no-ui --subagents hidden --tools collapsed --logs stderr",
    "dev:tui": "rm -rf .eve .output .workflow-data && eve dev --subagents hidden --tools collapsed --logs stderr",
    "dev:verbose": "rm -rf .eve .output .workflow-data && eve dev --subagents full --tools full --logs stderr",
    "smoke": "node scripts/smoke.mjs",
    "start": "eve start",
    "typecheck": "tsgo",
    "web:dev": "pnpm --filter @eveable/web dev",
    "web:build": "pnpm --filter @eveable/web build",
    "web:lint": "pnpm --filter @eveable/web lint",
    "web:typecheck": "pnpm --filter @eveable/core typecheck && pnpm --filter @eveable/web typecheck",
    "test": "vitest run",
    "web:test": "vitest run",
    "web:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "member:provision": "node --env-file-if-exists=.env.local --import tsx scripts/member.ts provision",
    "member:revoke": "node --env-file-if-exists=.env.local --import tsx scripts/member.ts revoke",
    "web:ci": "pnpm run web:lint && pnpm run web:typecheck && pnpm run test && pnpm run web:build",
    "test:integration": "node scripts/test-integration.mjs",
    "web:e2e:live": "playwright test tests/browser/live.spec.ts",
    "release:reconcile": "tsx --env-file-if-exists=.env.local scripts/reconcile-release.ts"
  },
  "dependencies": {
    "@eveable/core": "workspace:*",
    "@vercel/connect": "0.2.2",
    "ai": "7.0.0-beta.178",
    "eve": "^0.11.4",
    "zod": "4.4.3",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.8",
    "jose": "6.1.3",
    "@vercel/blob": "2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "24.13.2",
    "@typescript/native-preview": "7.0.0-dev.20260523.1",
    "@vercel/sandbox": "3.3.0",
    "drizzle-kit": "^0.31.9",
    "microsandbox": "^0.5.7",
    "prettier": "^3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "ai": "7.0.0-beta.178"
  },
  "resolutions": {
    "ai": "7.0.0-beta.178"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
